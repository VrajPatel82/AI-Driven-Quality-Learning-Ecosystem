# Backend env example
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/lecture_system
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRE=24h
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379
GROQ_API_KEY=
GROQ_TUTOR_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash-lite
AI_ASSISTANT_TIMEOUT_MS=60000
AI_ASSISTANT_HISTORY_LIMIT=20
AI_ASSISTANT_MAX_OUTPUT_TOKENS=1200
AI_ASSISTANT_TEMPERATURE=0.4
API_URL=http://localhost:5000

# Backblaze B2 Object Storage Configuration (S3 Compatible)
STORAGE_PROVIDER=b2
B2_BUCKET_NAME=your_b2_bucket_name
B2_ENDPOINT=s3.your-region.backblazeb2.com
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_PUBLIC_URL=
